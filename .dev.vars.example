# Local configuration for `wrangler dev`: copy to .dev.vars (gitignored).
# Production values are Worker secrets (`wrangler secret put <NAME>`) and vars.
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# The local Flutter apps (admin on 50001, tenant on 50002).
ALLOWED_ORIGINS="http://localhost:50001,http://localhost:50002"
# Cloudflare Turnstile's always-pass test secret (the apps use the matching test site key 1x00000000000000000000AA).
# Production and development use the widget's real secret (a Worker secret).
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
