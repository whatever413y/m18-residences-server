# Server Port
PORT=50000

# Browser origins allowed by CORS during development (comma-separated):
# admin app on 50001, tenant app (M18-Residences) on 50002
LOCALHOST_URL="http://localhost:50001,http://localhost:50002"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/m18"

# JWT Secret
JWT_SECRET="your_jwt_secret"

# Production URL
PRODUCTION_URL="https://your-production-url.com"

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=verysecurepassword

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=my-images
R2_ACCOUNT_ID=your_account_id_here
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

