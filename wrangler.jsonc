// The API Worker (production: name "api"; env "development": "development-api"). Secrets (JWT_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD,
// TURNSTILE_SECRET) are set with `wrangler secret put`; for `wrangler dev` they come from .dev.vars (see .dev.vars.example).
{
  "name": "api",
  "main": "build/index.js",
  "compatibility_date": "2026-09-29",
  "build": { "command": "worker-build --release" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "m18-residences",
      // Created by m18-residences-infra (Terraform output d1_database_id).
      "database_id": "77835b0c-7eb4-4aaa-a6f0-6d03bba89e36",
      "migrations_dir": "crates/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "m18-residences" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Login attempts per client and login route (key "<route>:<IP>"): 10 a minute, counted per Cloudflare location.
  "ratelimits": [{ "name": "LOGIN_RATE_LIMITER", "namespace_id": "1801", "simple": { "limit": 10, "period": 60 } }],
  // Daily at 02:00 Manila (18:00 UTC): retry the archives that failed (table file_cleanup).
  "triggers": { "crons": ["0 18 * * *"] },
  // The deployed apps. Local dev and e2e override it (.dev.vars / --env-file).
  "vars": {
    "ALLOWED_ORIGINS": "https://admin.m18-residences.workers.dev,https://my.m18-residences.workers.dev"
  },
  "observability": { "enabled": true },
  // No preview links for production: a preview would run with the production D1 and R2 bindings.
  "preview_urls": false,

  // The development API (https://development-api.m18-residences.workers.dev), deployed from the development branch
  // with `--env development`. Environments don't inherit bindings or vars, so all of them are repeated here; it
  // uses only the -dev database and bucket (synthetic data, tools/dev-seed). Secrets: `wrangler secret put
  // <NAME> --env development`.
  "env": {
    "development": {
      "name": "development-api",
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "m18-residences-dev",
          // m18-residences-infra output d1_dev_database_id.
          "database_id": "246609ce-1f8b-460f-a90e-a3c93074b868",
          "migrations_dir": "crates/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "m18-residences-dev" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [{ "name": "LOGIN_RATE_LIMITER", "namespace_id": "1802", "simple": { "limit": 10, "period": 60 } }],
      "triggers": { "crons": ["0 18 * * *"] },
      // The apps' preview links: development-admin, pr-12-admin, development-my, ...
      "vars": {
        "ALLOWED_ORIGINS": "https://*-admin.m18-residences.workers.dev,https://*-my.m18-residences.workers.dev"
      }
    }
  }
}
